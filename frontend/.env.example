# Public, non-secret settings. Fill in after deployment (see ../docs/demo-runbook.md).
# Copy to .env.local. Never put private keys here.
NEXT_PUBLIC_ESCROW=
NEXT_PUBLIC_NFT=
NEXT_PUBLIC_COORDINATOR=
NEXT_PUBLIC_VAULT_BASE=
NEXT_PUBLIC_VAULT_UNI=
NEXT_PUBLIC_TOKEN_BASE=
NEXT_PUBLIC_TOKEN_UNI=
# Block each contract set was deployed at (log queries start here).
NEXT_PUBLIC_BASE_FROM_BLOCK=
NEXT_PUBLIC_UNI_FROM_BLOCK=
# Optional RPC overrides.
NEXT_PUBLIC_BASE_RPC=https://base-sepolia-rpc.publicnode.com
NEXT_PUBLIC_UNI_RPC=https://sepolia.unichain.org
